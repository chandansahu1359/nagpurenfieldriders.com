# Nagpur Enfield Riders - Environment Configuration Template
# Copy this file to .env.local for local development overrides

# Canonical public site URL
NEXT_PUBLIC_SITE_URL=https://www.nagpurenfieldriders.com

# Official contact inbox & coordinates
